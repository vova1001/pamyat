# Скопируйте в .env и заполните (make env сделает это и создаст случайные пароли).
# Без .env проект тоже поднимется: в лог backend будет записана одноразовая ссылка входа администратора.

# Адрес сайта для гостя: ссылки на оплату и возврат с неё
PUBLIC_URL=http://localhost:8000
WEB_PORT=8000

# Вход в кабинет: администратор. На сервере ADMIN_PASSWORD оставьте пустым — в лог придёт одноразовая ссылка,
# по ней администратор сам придумает пароль. Задан — только первый пароль (сменённый в кабинете не сбрасывается).
ADMIN_EMAIL=vovaoleshko05@mail.ru
ADMIN_PASSWORD=

# База данных (наружу не открыта)
POSTGRES_PASSWORD=

# Оплата: test — тестовая страница оплаты (деньги не списываются); yookassa — ЮKassa.
# yookassa без YOOKASSA_SHOP_ID/YOOKASSA_SECRET_KEY — работает как test (предупреждение в журнале).
PAYMENT_PROVIDER=test
# Секрет подписи уведомлений тестовой заглушки; пусто — случайный при запуске.
PAYMENT_WEBHOOK_SECRET=
# ЮKassa: shopId и секретный ключ (ключ тестового магазина начинается с test_, боевого — live_). Ключ — только здесь.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Чек 54-ФЗ через ЮKassa: false — самозанятый (чек в «Мой налог»); true — ИП с чеками ЮKassa. Ставка НДС: 1 — без НДС.
YOOKASSA_RECEIPT=false
YOOKASSA_VAT_CODE=1
# Сервер сам заходит на свой адрес раз в 10 минут, чтобы хостинг его не усыплял (на Render включено само)
KEEP_AWAKE=false

# Примеры мероприятий из эскиза для показа (true/false)
SEED_DEMO=true

# Где фото из кабинета: disk (том uploads) или postgres (хостинг без постоянного диска, Render)
MEDIA_STORE=disk

# На сервере с https — true
COOKIE_SECURE=false

# Откуда брать базовые образы Docker (зеркало Docker Hub)
REGISTRY=mirror.gcr.io/library

# Хостинг с генерацией пароля (Render): ADMIN_PASSWORD временный — при первом входе обязательная смена
ADMIN_PASSWORD_TEMPORARY=false
# Забыли пароль администратора, а консоли нет: true → в лог при старте новая ссылка входа; потом убрать
ADMIN_LINK_ON_START=false

# Уведомления владелице. Пусто — письма и сообщения только в журнал (кабинет → «Уведомления»), как раньше.
# Почта через Resend (resend.com → API Keys). До подтверждения своего домена письма уходят только
# на почту владельца аккаунта Resend; отправитель по умолчанию — КофеСобакен <onboarding@resend.dev>.
RESEND_API_KEY=
MAIL_FROM=
# Бот Telegram (@BotFather → /newbot → токен). Чат подключается в кабинете: «Уведомления» → «Подключить Telegram».
TELEGRAM_BOT_TOKEN=
