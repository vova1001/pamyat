# Скопируйте в .env и заполните (make env сделает это и создаст случайные пароли).
# Без .env проект тоже поднимется: в лог backend будет записана одноразовая ссылка входа администратора.

# Адрес сайта для гостя: ссылки на оплату и возврат с неё
PUBLIC_URL=http://localhost:8000
WEB_PORT=8000

# Вход в кабинет: администратор. На сервере ADMIN_PASSWORD оставьте пустым — в лог придёт одноразовая ссылка,
# по ней администратор сам придумает пароль. Задан — только первый пароль (сменённый в кабинете не сбрасывается).
ADMIN_EMAIL=vovaoleshko05@mail.ru
ADMIN_PASSWORD=

# База данных (наружу не открыта)
POSTGRES_PASSWORD=

# Оплата: сейчас только тестовая заглушка (test). Секрет подписи уведомлений; пусто — случайный при запуске.
PAYMENT_PROVIDER=test
PAYMENT_WEBHOOK_SECRET=

# Примеры мероприятий из эскиза для показа (true/false)
SEED_DEMO=true

# Где фото из кабинета: disk (том uploads) или postgres (хостинг без постоянного диска, Render)
MEDIA_STORE=disk

# На сервере с https — true
COOKIE_SECURE=false

# Откуда брать базовые образы Docker (зеркало Docker Hub)
REGISTRY=mirror.gcr.io/library

# Хостинг с генерацией пароля (Render): ADMIN_PASSWORD временный — при первом входе обязательная смена
ADMIN_PASSWORD_TEMPORARY=false
# Забыли пароль администратора, а консоли нет: true → в лог при старте новая ссылка входа; потом убрать
ADMIN_LINK_ON_START=false
