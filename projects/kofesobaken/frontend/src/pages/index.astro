---
import '../styles/fonts.css';
import '../styles/site.css';
import Sprite from '../components/site/Sprite.astro';
import Header from '../components/site/Header.astro';
import Hero from '../components/site/Hero.astro';
import Why from '../components/site/Why.astro';
import Menu from '../components/site/Menu.astro';
import Dogs from '../components/site/Dogs.astro';
import Events from '../components/site/Events.astro';
import Booking from '../components/site/Booking.astro';
import Order from '../components/site/Order.astro';
import Find from '../components/site/Find.astro';
import Contacts from '../components/site/Contacts.astro';
import Footer from '../components/site/Footer.astro';
import EventModal from '../components/site/EventModal.astro';
import Ask from '../components/site/Ask.astro';
import Seo from '../components/Seo.astro';
import { getSite } from '../lib/server';
import { cafeJsonLd, jsonForScript, siteUrl } from '../lib/seo';

const site = await getSite();
const c = site.content;
Astro.response.headers.set('Cache-Control', 'no-store');
---
<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<Seo title="КофеСобакен — кофейня с собаками в Ростове-на-Дону" description={`Кофейня с маленькими собаками в зале. Приходите сами или со своим питомцем. Ростов-на-Дону, ${c.address}.`} path="/" />
<script type="application/ld+json" set:html={jsonForScript(cafeJsonLd(c, siteUrl(Astro.url)))} />
</head>
<body>
<Sprite />
<Header />
<main id="top">
  <Hero content={c} />
  <Why content={c} />
  <Menu menu={site.menu} />
  <Dogs content={c} />
  <Events events={site.events} />
  <Booking prepayKop={site.order.booking_prepay_kop} />
  <Order minKop={site.order.delivery_min_kop} radiusKm={site.order.delivery_radius_km} />
  <Find content={c} />
  <Contacts />
</main>
<Footer content={c} />
<EventModal />
<Ask bot={site.question_bot} />
<script>import '../scripts/site.ts';</script>
</body>
</html>
