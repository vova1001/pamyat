---
import '../styles/site.css';
import Sprite from '../components/site/Sprite.astro';
import Header from '../components/site/Header.astro';
import Hero from '../components/site/Hero.astro';
import Why from '../components/site/Why.astro';
import Menu from '../components/site/Menu.astro';
import Dogs from '../components/site/Dogs.astro';
import Events from '../components/site/Events.astro';
import Booking from '../components/site/Booking.astro';
import Order from '../components/site/Order.astro';
import Find from '../components/site/Find.astro';
import Contacts from '../components/site/Contacts.astro';
import Footer from '../components/site/Footer.astro';
import EventModal from '../components/site/EventModal.astro';
import { getSite } from '../lib/server';

const site = await getSite();
const c = site.content;
Astro.response.headers.set('Cache-Control', 'no-store');
---
<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>КофеСобакен — кофейня с собаками в Ростове-на-Дону</title>
<meta name="description" content={`Кофейня с маленькими собаками в зале. Приходите сами или со своим питомцем. Ростов-на-Дону, ${c.address}.`}>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@500;700;800&family=Manrope:wght@400;500;600;700;800&family=Caveat:wght@600;700&display=swap" rel="stylesheet">
</head>
<body>
<Sprite />
<Header />
<main id="top">
  <Hero content={c} />
  <Why content={c} />
  <Menu menu={site.menu} />
  <Dogs content={c} />
  <Events events={site.events} />
  <Booking prepayKop={site.order.booking_prepay_kop} />
  <Order minKop={site.order.delivery_min_kop} radiusKm={site.order.delivery_radius_km} />
  <Find content={c} />
  <Contacts />
</main>
<Footer content={c} />
<EventModal />
<script>import '../scripts/site.ts';</script>
</body>
</html>
