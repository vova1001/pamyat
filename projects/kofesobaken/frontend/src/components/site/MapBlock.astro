---
// Блок 3D-карты — перенесён из эскиза как есть. Дизайн дорабатывает карту в эскизе;
// финальную версию переносим сюда же без изменений (разметка + скрипт ниже).
---
      <div class="map rv" id="map3d">
        <a class="map__shot" href="https://yandex.ru/maps/?rtext=~47.229234%2C39.771960&amp;rtt=auto" target="_blank" rel="noopener" aria-label="Открыть маршрут в Яндекс.Картах"><img src="/img/map-3d.jpg" width="2800" height="2000" alt="Объёмная карта: КофеСобакен на улице Сарьяна, 34, Нахичевань, Ростов-на-Дону" loading="lazy"></a>
        <div class="map__live" aria-label="Интерактивная 3D-карта: Ростов-на-Дону, ул. Сарьяна, 34"></div>
        <div class="mpin" aria-hidden="true"><div class="mpin__tag"><b>КофеСобакен</b><span>ул. Сарьяна, 34</span></div><span class="mpin__head"><svg><use href="#paw"/></svg></span><i class="mpin__dot"></i></div>
        <span class="map__hint"><svg><use href="#paw"/></svg>Покрутите карту</span>
        <a class="btn btn--main map__route" href="https://yandex.ru/maps/?rtext=~47.229234%2C39.771960&amp;rtt=auto" target="_blank" rel="noopener"><svg><use href="#pin"/></svg>Построить маршрут</a>
        <span class="map__copy">© OpenStreetMap, OpenFreeMap</span>
      </div>
<script is:inline>
/* ---------- 3D-карта: MapLibre GL + OpenFreeMap; без сети/WebGL остаётся снимок img/map-3d.jpg ---------- */
(() => {
  const box = document.getElementById('map3d'); if (!box) return;
  const CAFE = [39.771960, 47.229234];
  const LIB = 'https://unpkg.com/maplibre-gl@5.24.0/dist/maplibre-gl';
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const C = { land:'#F5ECDF', block:'#F1E4D3', park:'#D3DCBF', wood:'#C3CFA9', water:'#C9D9D3', road:'#FFFBF5', casing:'#E6D3BE', minor:'#FFF9F1', rail:'#D2BFAA', label:'#6B5446', halo:'#FFF9F1', bLow:'#F8EDE0', bMid:'#F0DCC6', bHigh:'#E3C2A2', cafe:'#E4572E' };
  const name = ['coalesce', ['get', 'name:ru'], ['get', 'name']];
  const W = (a, b) => ['interpolate', ['exponential', 1.6], ['zoom'], 13, a, 18, b];
  const cls = (...c) => ['match', ['get', 'class'], c, true, false];
  const style = {
    version: 8,
    glyphs: 'https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf',
    sources: {
      omt: { type: 'vector', url: 'https://tiles.openfreemap.org/planet', attribution: '<a href="https://openfreemap.org" target="_blank">OpenFreeMap</a> © <a href="https://www.openmaptiles.org/" target="_blank">OpenMapTiles</a> © <a href="https://www.openstreetmap.org/copyright" target="_blank">OpenStreetMap</a>' },
      cafe: { type: 'geojson', data: { type: 'Feature', properties: {}, geometry: { type: 'Polygon', coordinates: [[[39.7718525,47.229267],[39.7718907,47.2291595],[39.77198,47.2291742],[39.7719758,47.2291861],[39.772068,47.2292013],[39.772034,47.2292968],[39.7718525,47.229267]]] } } }
    },
    sky: { 'sky-color': '#F6E3CF', 'horizon-color': '#F7EFE4', 'fog-color': '#F7EFE4', 'sky-horizon-blend': .6, 'horizon-fog-blend': .7, 'fog-ground-blend': .55, 'atmosphere-blend': 0 },
    light: { anchor: 'viewport', color: '#FFF1DE', intensity: .45, position: [1.3, 200, 40] },
    layers: [
      { id: 'bg', type: 'background', paint: { 'background-color': C.land } },
      { id: 'landuse', type: 'fill', source: 'omt', 'source-layer': 'landuse', filter: cls('residential', 'suburb', 'neighbourhood', 'commercial', 'retail'), paint: { 'fill-color': C.block, 'fill-opacity': .7 } },
      { id: 'park', type: 'fill', source: 'omt', 'source-layer': 'park', paint: { 'fill-color': C.park } },
      { id: 'green', type: 'fill', source: 'omt', 'source-layer': 'landcover', filter: cls('grass', 'wood', 'farmland', 'wetland'), paint: { 'fill-color': ['match', ['get', 'class'], 'wood', C.wood, C.park], 'fill-opacity': .85 } },
      { id: 'water', type: 'fill', source: 'omt', 'source-layer': 'water', paint: { 'fill-color': C.water } },
      { id: 'rail', type: 'line', source: 'omt', 'source-layer': 'transportation', filter: cls('rail', 'transit'), paint: { 'line-color': C.rail, 'line-width': W(.6, 2.4), 'line-dasharray': [3, 2] } },
      { id: 'road-case', type: 'line', source: 'omt', 'source-layer': 'transportation', filter: cls('motorway', 'trunk', 'primary', 'secondary', 'tertiary'), layout: { 'line-cap': 'round', 'line-join': 'round' }, paint: { 'line-color': C.casing, 'line-width': W(3, 30) } },
      { id: 'road-minor', type: 'line', source: 'omt', 'source-layer': 'transportation', filter: cls('minor', 'service', 'track', 'path', 'pedestrian'), layout: { 'line-cap': 'round', 'line-join': 'round' }, paint: { 'line-color': C.minor, 'line-width': ['interpolate', ['exponential', 1.6], ['zoom'], 13, ['match', ['get', 'class'], ['path', 'track'], .4, 'service', .6, 1], 18, ['match', ['get', 'class'], ['path', 'track'], 3, 'service', 7, 14]] } },
      { id: 'road', type: 'line', source: 'omt', 'source-layer': 'transportation', filter: cls('motorway', 'trunk', 'primary', 'secondary', 'tertiary'), layout: { 'line-cap': 'round', 'line-join': 'round' }, paint: { 'line-color': C.road, 'line-width': W(2, 25) } },
      { id: 'buildings', type: 'fill-extrusion', source: 'omt', 'source-layer': 'building', minzoom: 14, paint: {
        'fill-extrusion-color': ['interpolate', ['linear'], ['coalesce', ['get', 'render_height'], 6], 0, C.bLow, 14, C.bMid, 40, C.bHigh],
        'fill-extrusion-height': ['interpolate', ['linear'], ['zoom'], 14, 0, 15.2, ['coalesce', ['get', 'render_height'], 6]],
        'fill-extrusion-base': ['coalesce', ['get', 'render_min_height'], 0], 'fill-extrusion-opacity': .94, 'fill-extrusion-vertical-gradient': true } },
      { id: 'cafe', type: 'fill-extrusion', source: 'cafe', paint: { 'fill-extrusion-color': C.cafe, 'fill-extrusion-height': 6.5, 'fill-extrusion-opacity': 1 } },
      { id: 'street-names', type: 'symbol', source: 'omt', 'source-layer': 'transportation_name', minzoom: 14, layout: { 'symbol-placement': 'line', 'text-field': name, 'text-font': ['Noto Sans Bold'], 'text-size': ['interpolate', ['linear'], ['zoom'], 14, 10, 18, 14], 'text-letter-spacing': .04, 'text-max-angle': 30 }, paint: { 'text-color': C.label, 'text-halo-color': C.halo, 'text-halo-width': 1.6 } },
      { id: 'places', type: 'symbol', source: 'omt', 'source-layer': 'place', filter: cls('suburb', 'neighbourhood', 'quarter'), layout: { 'text-field': name, 'text-font': ['Noto Sans Bold'], 'text-size': 13, 'text-transform': 'uppercase', 'text-letter-spacing': .18 }, paint: { 'text-color': 'rgba(107,62,38,.55)', 'text-halo-color': C.halo, 'text-halo-width': 1.4 } }
    ]
  };
  const view = () => innerWidth < 760 ? { center: CAFE, zoom: 16.25, pitch: 58, bearing: -28 } : { center: CAFE, zoom: 16.6, pitch: 62, bearing: -28 };

  let started = false;
  const start = () => {
    if (started) return; started = true;
    const css = document.createElement('link'); css.rel = 'stylesheet'; css.href = LIB + '.css'; document.head.appendChild(css);
    const js = document.createElement('script'); js.src = LIB + '.js'; js.async = true;
    js.onload = init; js.onerror = () => {}; // нет сети — остаётся снимок
    document.head.appendChild(js);
  };
  function init() {
    const ml = window.maplibregl; if (!ml) return;
    let map;
    try {
      map = new ml.Map({ container: box.querySelector('.map__live'), style, ...view(), maxPitch: 70, minZoom: 13, maxZoom: 19, attributionControl: { compact: true }, cooperativeGestures: true, scrollZoom: false, fadeDuration: 0,
        locale: { 'CooperativeGesturesHandler.WindowsHelpText': 'Ctrl + колесо мыши — приблизить карту', 'CooperativeGesturesHandler.MacHelpText': '⌘ + колесо мыши — приблизить карту', 'CooperativeGesturesHandler.MobileHelpText': 'Двигайте карту двумя пальцами', 'NavigationControl.ZoomIn': 'Приблизить', 'NavigationControl.ZoomOut': 'Отдалить', 'NavigationControl.ResetBearing': 'Вернуть север' } });
    } catch (e) { return; } // нет WebGL — остаётся снимок
    window.kofeMap = map;
    map.addControl(new ml.NavigationControl({ visualizePitch: true }), 'top-right');
    map.on('error', e => console.warn('map3d:', e.error && e.error.message));
    map.once('idle', () => {
      box.classList.add('is-live');
      new ml.Marker({ element: box.querySelector('.mpin'), anchor: 'bottom' }).setLngLat(CAFE).addTo(map);
      box.querySelector('.maplibregl-ctrl-attrib')?.classList.remove('maplibregl-compact-show'); // свернуть подпись, чтобы не налезала на кнопку
      orbit(map);
    });
  }
  // медленный облёт вокруг кофейни; пауза при касании и вне экрана
  function orbit(map) {
    if (reduce) return;
    let on = true, seen = true, last = 0, wait;
    const step = t => { if (on && seen && last) map.setBearing((map.getBearing() + (t - last) * 0.003) % 360); last = t; requestAnimationFrame(step); };
    requestAnimationFrame(step);
    const pause = () => { on = false; clearTimeout(wait); wait = setTimeout(() => { on = true; }, 7000); };
    ['mousedown', 'touchstart', 'wheel'].forEach(ev => map.getCanvasContainer().addEventListener(ev, pause, { passive: true }));
    new IntersectionObserver(([e]) => { seen = e.isIntersecting; }).observe(box);
  }
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(([e]) => { if (e.isIntersecting) { io.disconnect(); start(); } }, { rootMargin: '900px 0px' });
    io.observe(box);
  } else start();
})();
</script>
