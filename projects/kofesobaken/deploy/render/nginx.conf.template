# nginx внутри образа для Render. ${PORT} подставляет start.sh. Те же маршруты, что deploy/nginx.conf.
worker_processes 1;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 512; }

http {
    include /etc/nginx/mime.types;
    access_log off; # запросы пишет backend
    client_body_temp_path /tmp/nginx-body;
    proxy_temp_path /tmp/nginx-proxy;
    fastcgi_temp_path /tmp/nginx-fastcgi;
    uwsgi_temp_path /tmp/nginx-uwsgi;
    scgi_temp_path /tmp/nginx-scgi;
    client_max_body_size 10m;
    server_tokens off;

    # Адрес посетителя (для ограничения попыток входа). Перед нами прокси Render: он ДОПИСЫВАЕТ адрес посетителя
    # в конец X-Forwarded-For и не очищает то, что прислал сам посетитель. Поэтому берём последний адрес
    # (real_ip_recursive off), а не первый — первый посетитель может подделать.
    set_real_ip_from 0.0.0.0/0;
    set_real_ip_from ::/0;
    real_ip_header X-Forwarded-For;
    real_ip_recursive off;

    server {
        listen ${PORT};
        server_name _;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;

        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;

        location /api/      { proxy_pass http://127.0.0.1:8080; }
        location /uploads/  { proxy_pass http://127.0.0.1:8080; }
        location = /healthz { proxy_pass http://127.0.0.1:8080; }

        location /img/    { proxy_pass http://127.0.0.1:4321; expires 7d; }
        location /_astro/ { proxy_pass http://127.0.0.1:4321; expires 1y; }
        location /        { proxy_pass http://127.0.0.1:4321; }
    }
}
